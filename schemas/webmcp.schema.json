{
  "$ref": "#/definitions/WebMCPConfig",
  "definitions": {
    "WebMCPConfig": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "site": {
          "type": "object",
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "default": ""
            },
            "locale": {
              "type": "string",
              "default": "en"
            },
            "public_url": {
              "type": "string"
            }
          },
          "required": [
            "domain",
            "name"
          ],
          "additionalProperties": false
        },
        "origin": {
          "type": "object",
          "properties": {
            "base_url": {
              "type": "string",
              "format": "uri"
            },
            "allowed_origins": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/WebMCPConfig/properties/origin/properties/base_url"
              },
              "minItems": 1
            },
            "forward_cookies": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "base_url",
            "allowed_origins"
          ],
          "additionalProperties": false
        },
        "features": {
          "type": "object",
          "properties": {
            "inject_html": {
              "type": "boolean",
              "default": true
            },
            "webmcp_landing": {
              "type": "boolean",
              "default": true
            },
            "manifest": {
              "type": "boolean",
              "default": true
            },
            "link_header": {
              "type": "boolean",
              "default": true
            },
            "link_tag": {
              "type": "boolean",
              "default": true
            },
            "llms_txt": {
              "type": "boolean",
              "default": true
            },
            "robots_txt": {
              "type": "boolean",
              "default": true
            },
            "agents_md": {
              "type": "boolean",
              "default": true
            },
            "api_catalog": {
              "type": "boolean",
              "default": true
            },
            "agent_skills": {
              "type": "boolean",
              "default": true
            },
            "agent_skills_index": {
              "type": "boolean",
              "default": true
            },
            "subresource_integrity": {
              "type": "boolean",
              "default": true
            },
            "fallback_widget": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "manifest": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "default": "/.well-known/webmcp.json"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "webmcp_landing": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path",
              "default": "/mcp"
            },
            "template": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "llms_txt": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path",
              "default": "/llms.txt"
            },
            "mode": {
              "type": "string",
              "enum": [
                "merge",
                "replace",
                "passthrough",
                "synthesize"
              ],
              "default": "merge"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "robots_txt": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path",
              "default": "/robots.txt"
            },
            "mode": {
              "type": "string",
              "enum": [
                "merge",
                "passthrough"
              ],
              "default": "merge"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "agents_md": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path",
              "default": "/.well-known/agents.md"
            },
            "mode": {
              "type": "string",
              "enum": [
                "merge",
                "replace",
                "passthrough",
                "synthesize"
              ],
              "default": "merge"
            },
            "aliases": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path"
              },
              "default": [
                "/AGENTS.md",
                "/agents.md"
              ]
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "api_catalog": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path",
              "default": "/.well-known/api-catalog"
            },
            "mode": {
              "type": "string",
              "enum": [
                "merge",
                "replace",
                "passthrough",
                "synthesize"
              ],
              "default": "merge"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "agent_skills": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path",
              "default": "/.well-known/agent-skills/site/SKILL.md"
            },
            "mode": {
              "type": "string",
              "enum": [
                "merge",
                "replace",
                "passthrough",
                "synthesize"
              ],
              "default": "synthesize"
            },
            "name": {
              "type": "string",
              "default": ""
            },
            "description": {
              "type": "string",
              "default": ""
            },
            "aliases": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path"
              },
              "default": [
                "/.well-known/agent-skills/site/SKILLS.md",
                "/.well-known/agent-skills/site/skill.md",
                "/.well-known/agent-skills/site/skills.md"
              ]
            },
            "hints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "heading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "heading",
                  "body"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "agent_skills_index": {
          "type": "object",
          "properties": {
            "path": {
              "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path",
              "default": "/.well-known/agent-skills/index.json"
            },
            "mode": {
              "type": "string",
              "enum": [
                "synthesize",
                "passthrough"
              ],
              "default": "synthesize"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "paths": {
          "type": "object",
          "properties": {
            "namespace": {
              "$ref": "#/definitions/WebMCPConfig/properties/manifest/properties/path",
              "default": "/_webmcp"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "injection": {
          "type": "object",
          "properties": {
            "exclude_paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "cache": {
          "type": "object",
          "properties": {
            "manifest_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "manifest_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "manifest_swr": {
              "type": "integer",
              "minimum": 0,
              "default": 604800
            },
            "manifest_sie": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "landing_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "landing_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "landing_swr": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "landing_sie": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "llms_txt_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "llms_txt_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 21600
            },
            "llms_txt_swr": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "llms_txt_sie": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "robots_txt_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "robots_txt_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 21600
            },
            "robots_txt_swr": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "robots_txt_sie": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agents_md_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "agents_md_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 21600
            },
            "agents_md_swr": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agents_md_sie": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agents_md_redirect_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agents_md_redirect_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 604800
            },
            "api_catalog_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "api_catalog_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 21600
            },
            "api_catalog_swr": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "api_catalog_sie": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agent_skills_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "agent_skills_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 21600
            },
            "agent_skills_swr": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agent_skills_sie": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agent_skills_redirect_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agent_skills_redirect_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 604800
            },
            "agent_skills_index_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 300
            },
            "agent_skills_index_s_maxage": {
              "type": "integer",
              "minimum": 0,
              "default": 21600
            },
            "agent_skills_index_swr": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "agent_skills_index_sie": {
              "type": "integer",
              "minimum": 0,
              "default": 86400
            },
            "bootstrap_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 31536000
            },
            "widget_max_age": {
              "type": "integer",
              "minimum": 0,
              "default": 31536000
            },
            "executor_defaults": {
              "type": "object",
              "properties": {
                "max_age": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "s_maxage": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 300
                },
                "swr": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 1800
                },
                "sie": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 86400
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "cors": {
          "type": "object",
          "properties": {
            "allowed_origins": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "health": {
          "type": "object",
          "properties": {
            "public": {
              "type": "boolean",
              "default": true
            },
            "token": {
              "type": "string",
              "default": ""
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "dev": {
          "type": "object",
          "properties": {
            "origin": {
              "type": "string",
              "default": "http://localhost:8080"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "rate_limit": {
          "type": "object",
          "properties": {
            "requests_per_minute_per_ip": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 60
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "input_schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "object"
                  },
                  "required": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "properties": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "string",
                            "integer",
                            "number",
                            "boolean",
                            "array"
                          ]
                        },
                        "description": {
                          "type": "string"
                        },
                        "minimum": {
                          "type": "number"
                        },
                        "maximum": {
                          "type": "number"
                        },
                        "pattern": {
                          "type": "string"
                        },
                        "enum": {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "boolean"
                            ]
                          }
                        },
                        "items": {
                          "$ref": "#/definitions/WebMCPConfig/properties/tools/items/properties/input_schema/properties/properties/additionalProperties"
                        },
                        "default": {
                          "type": [
                            "string",
                            "number",
                            "boolean"
                          ]
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": false
                    },
                    "default": {}
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "default": {
                  "type": "object",
                  "required": [],
                  "properties": {}
                }
              },
              "executor": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "sitemap_filter"
                      },
                      "sitemap_url": {
                        "$ref": "#/definitions/WebMCPConfig/properties/origin/properties/base_url"
                      },
                      "max_results": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 200,
                        "default": 20
                      }
                    },
                    "required": [
                      "type",
                      "sitemap_url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "rss_feed"
                      },
                      "feed_url": {
                        "$ref": "#/definitions/WebMCPConfig/properties/origin/properties/base_url"
                      },
                      "max_items": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 200,
                        "default": 20
                      }
                    },
                    "required": [
                      "type",
                      "feed_url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "dom_extract"
                      },
                      "url_template": {
                        "type": "string",
                        "minLength": 1
                      },
                      "selector": {
                        "type": "string",
                        "default": "main, article, [role=main]"
                      },
                      "strip": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "default": [
                          "nav",
                          "footer",
                          "aside",
                          "script",
                          "style",
                          "noscript"
                        ]
                      },
                      "max_chars": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 100000,
                        "default": 8000
                      }
                    },
                    "required": [
                      "type",
                      "url_template"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "http_json"
                      },
                      "url_template": {
                        "type": "string",
                        "minLength": 1
                      },
                      "method": {
                        "type": "string",
                        "enum": [
                          "GET",
                          "POST"
                        ],
                        "default": "GET"
                      },
                      "project": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "array",
                              "first",
                              "raw"
                            ],
                            "default": "raw"
                          },
                          "fields": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "type",
                      "url_template"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "http_get"
                      },
                      "url_template": {
                        "type": "string",
                        "minLength": 1
                      },
                      "method": {
                        "type": "string",
                        "enum": [
                          "GET"
                        ],
                        "default": "GET"
                      },
                      "max_bytes": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 10000000,
                        "default": 1048576
                      },
                      "allowed_content_types": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "default": [
                          "text/*",
                          "application/json",
                          "application/xml",
                          "application/rss+xml",
                          "application/atom+xml"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "url_template"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "annotations": {
                "type": "object",
                "properties": {
                  "read_only_hint": {
                    "type": "boolean"
                  },
                  "untrusted_content_hint": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "cache": {
                "type": "object",
                "properties": {
                  "max_age": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "s_maxage": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "swr": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sie": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "rate_limit": {
                "type": "object",
                "properties": {
                  "burst": {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "description",
              "executor"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "autosubmit": {
                "type": "boolean",
                "default": false
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "selector",
                    "description"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "name",
              "description",
              "selector"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "schema_version",
        "site",
        "origin",
        "tools"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
